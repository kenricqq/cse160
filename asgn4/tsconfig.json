{
	"compilerOptions": {
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"allowJs": true,
		"checkJs": false,
		"noEmitOnError": true,
		// "noEmit": true,
		// "types": ["vite/client", "vite-plugin-glsl/ext"],
	},
	"include": ["src/**/*.ts", "geometry/**/*.ts", "lib/**/*.ts"],
}
